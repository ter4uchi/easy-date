    "easy-date",
    "accessibility",
    "format",
    "datetime",
    "a11y"
  ],
  "author": "ter4uchi",
  "homepage": "https://github.com/ter4uchi/easy-date#readme",
  "bugs": {
    "url": "https://github.com/ter4uchi/easy-date/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ter4uchi/easy-date.git"
  },
  "publishConfig": {
